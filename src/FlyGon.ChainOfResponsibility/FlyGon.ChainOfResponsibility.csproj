<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>FlyGon.ChainOfResponsibility</PackageId>
    <Version>2.0.0</Version>
    <Authors>João Greco</Authors>
    <Company>Greco Labs</Company>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <RepositoryUrl>https://github.com/grecojoao/FlyGon.ChainOfResponsibility</RepositoryUrl>
    <Description>Easily use the Chain of Responsibility design pattern.</Description>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <NeutralLanguage></NeutralLanguage>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/grecojoao/FlyGon.ChainOfResponsibility</PackageProjectUrl>
    <PackageTags>Domain;DDD;Chain;ChainOfResponsibility;FlyGon;FlyGon.ChainOfResponsibility;</PackageTags>
    <PackageReleaseNotes>Updated to .NET 10 with latest dependencies.</PackageReleaseNotes>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DocumentationFile>obj\Debug\net10.0\FlyGon.ChainOfResponsibility.xml</DocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DocumentationFile>obj\Release\net10.0\FlyGon.ChainOfResponsibility.xml</DocumentationFile>
  </PropertyGroup>

</Project>